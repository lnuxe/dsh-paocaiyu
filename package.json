{
  "name": "@local/qwerty-autotype-ui",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "description": "Qwerty 跟打的对话界面：/qwerty-autotype 在对话里长出一张跟打卡片。",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnuxe/qwerty-autotype-ui.git"
  },
  "homepage": "https://github.com/lnuxe/qwerty-autotype-ui#readme",
  "bugs": {
    "url": "https://github.com/lnuxe/qwerty-autotype-ui/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "dicts.generated.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dicts.index.json",
    "NOTICE"
  ],
  "scripts": {
    "test": "node test-client-logic.mjs",
    "check": "node --check client.js",
    "index": "node scripts/build-index.mjs",
    "data": "node scripts/build-index.mjs && node scripts/build-dicts.mjs",
    "index:inline": "node scripts/build-index.mjs --count --inline client.js",
    "audit": "node scripts/audit-dicts.mjs",
    "verify": "node --check client.js && node test-client-logic.mjs && node scripts/smoke-apply.mjs && node scripts/check-size.mjs",
    "smoke": "node scripts/smoke-apply.mjs",
    "size": "node scripts/check-size.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^31.0.1"
  }
}
