{
  "name": "@lnuxe/paocaiyu",
  "version": "1.0.4",
  "type": "module",
  "description": "泡菜鱼（Paocaiyu）：在 DSH 对话输入框里练英文打字 —— /qwerty-autotype 起一张跟打卡片，371 本词库 41 万词。",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnuxe/dsh-paocaiyu.git"
  },
  "homepage": "https://github.com/lnuxe/dsh-paocaiyu#readme",
  "bugs": {
    "url": "https://github.com/lnuxe/dsh-paocaiyu/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "dicts.generated.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "dicts.index.json",
    "NOTICE"
  ],
  "scripts": {
    "test": "node test-client-logic.mjs",
    "check": "node --check client.js",
    "index": "node scripts/build-index.mjs",
    "data": "node scripts/build-index.mjs && node scripts/build-dicts.mjs",
    "index:inline": "node scripts/build-index.mjs --count --inline client.js",
    "audit": "node scripts/audit-dicts.mjs",
    "verify": "node --check client.js && node test-client-logic.mjs && node scripts/smoke-apply.mjs && node scripts/check-size.mjs",
    "smoke": "node scripts/smoke-apply.mjs",
    "size": "node scripts/check-size.mjs",
    "prepublish-check": "node scripts/publish-preflight.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^31.0.1"
  },
  "author": "lnuxe <lnuxe@users.noreply.github.com>",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "qwerty",
    "typing",
    "typing-practice",
    "dictation",
    "english",
    "vocabulary"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
